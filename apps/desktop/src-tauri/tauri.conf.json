{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Harness",
  "version": "0.1.0",
  "identifier": "local.ai-harness.desktop",
  "build": {
    "beforeBuildCommand": "pnpm --dir ../.. exec node tooling/prepare.mjs",
    "beforeDevCommand": "pnpm --dir ../.. exec node tooling/prepare.mjs",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AI Harness",
        "width": 1100,
        "height": 760,
        "minWidth": 640,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "icon": ["icons/icon.png"],
    "externalBin": ["binaries/harness-node"],
    "resources": {
      "resources/runtime/": "runtime/"
    }
  }
}
